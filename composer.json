{
  "name": "statamic/statamic",
  "type": "project",
  "description": "Statamic",
  "keywords": [
    "statamic",
    "cms",
    "flat file",
    "laravel"
  ],
  "require": {
    "php": "^8.4",
    "laravel/framework": "^13.24",
    "laravel/tinker": "^3.0.2",
    "statamic/cms": "^6.20",
    "statamic/ssg": "^4.1"
  },
  "require-dev": {
    "barryvdh/laravel-debugbar": "dev-master",
    "cboxdk/statamic-mcp": "^2.5",
    "driftingly/rector-laravel": "^2.5",
    "fakerphp/faker": "^1.24.1",
    "larastan/larastan": "^3.9.6",
    "laravel/boost": "^2.4.8",
    "laravel/pail": "^1.2.7",
    "laravel/pint": "^1.29.1",
    "laravel/sail": "^1.61",
    "mockery/mockery": "^1.6.12",
    "nunomaduro/collision": "^8.9.5",
    "pestphp/pest": "^5.0.4",
    "pestphp/pest-plugin-browser": "^5.0",
    "pestphp/pest-plugin-laravel": "^5.0.1",
    "pestphp/pest-plugin-phpstan": "^5.0.2",
    "pestphp/pest-plugin-rector": "^5.0.3",
    "phpstan/phpstan": "^2.2.8",
    "phpunit/phpunit": "^13.2.6",
    "rector/rector": "^2.6.1"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "setup": [
      "composer install",
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
      "@php artisan key:generate",
      "@php artisan migrate --force",
      "bun install",
      "bun run build"
    ],
    "pre-update-cmd": [
      "Statamic\\Console\\Composer\\Scripts::preUpdateCmd"
    ],
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi",
      "@php artisan statamic:install --ansi"
    ],
    "post-root-package-install": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
    ],
    "post-create-project-cmd": [
      "@php artisan key:generate --ansi",
      "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\""
    ],
    "post-update-cmd": [
      "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
      "@php artisan boost:update --ansi",
      "@update:requirements"
    ],
    "update:requirements": [
      "composer bump",
      "bunx npm-check-updates -u"
    ],
    "dev": [
      "Composer\\Config::disableProcessTimeout",
      "bunx concurrently -c \"#c4b5fd,#fb7185,#fdba74\" \"php artisan queue:listen --tries=1\" \"php artisan pail --timeout=0\" \"bun run dev\" --names=queue,logs,vite"
    ],
    "lint": [
      "rector",
      "pint --parallel",
      "bun run lint"
    ],
    "test:lint": [
      "pint --parallel --test",
      "rector --dry-run",
      "bun run test:lint"
    ],
    "test:types": "phpstan",
    "test:unit": [
      "pest --parallel --exclude-testsuite=Browser --exclude-group=console",
      "pest --group=console"
    ],
    "test:browser": "pest --testsuite=Browser",
    "test": [
      "@test:lint",
      "@test:types",
      "@test:unit",
      "@test:browser"
    ]
  },
  "extra": {
    "laravel": {
      "dont-discover": []
    }
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true,
      "php-http/discovery": true,
      "pixelfear/composer-dist-plugin": true
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
